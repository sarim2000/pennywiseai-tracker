    <string name="faq_transaction_types_section">Aina za Miamala</string>
    <string name="faq_wallet_credit_question">Kwa nini miamala ya pochi inawekwa kama Mkopo?</string>
    <string name="faq_wallet_credit_answer">Miamala ya pochi (Amazon Pay, Paytm, n.k.) inawekwa kama Mkopo kwa sababu inatozwa kwanza kwenye akaunti yako ya benki au kadi ya mkopo, si kukatwa moja kwa moja kutoka benki. Hii husaidia kufuatilia njia halisi ya malipo iliyotumika.</string>
    <string name="faq_transaction_types_question">Kuna tofauti gani kati ya aina 5 za miamala?</string>
    <string name="faq_transaction_types_answer">• Matumizi: Pesa zinazotoka kwenye akaunti yako (makato, manunuzi, malipo ya bili)\n• Mapato: Pesa zinazoingia kwenye akaunti yako (mshahara, marejesho, cashback)\n• Uwekezaji: Mifuko ya uwekezaji, hisa, SIP, akaunti za biashara ya hisa\n• Mkopo: Miamala ya kadi ya mkopo na malipo ya pochi (pesa utakazolipa baadaye)\n• Uhamisho: Pesa zinazohamishwa kati ya akaunti zako mwenyewe</string>
    <string name="faq_transfer_vs_expense_question">Nitumie Uhamisho lini badala ya Matumizi?</string>
    <string name="faq_transfer_vs_expense_answer">Tumia Uhamisho unapohamisha pesa kati ya akaunti zako mwenyewe (k.m. kutoka akiba kwenda akaunti ya kawaida). Haziathiri thamani yako halisi. Tumia Matumizi kwa matumizi halisi.</string>
    <string name="faq_sms_parsing_section">Kusoma SMS</string>
    <string name="faq_sms_not_detected_question">Kwa nini SMS zangu za benki hazitambuliwi?</string>
    <string name="faq_sms_not_detected_answer">Angalia kama benki yako inaungwa mkono kwenye orodha yetu. Kama haipo, iripoti kupitia GitHub. Hakikisha ruhusa za SMS zimetolewa na muundo wa mtumaji unalingana na SMS za kawaida za benki.</string>
    <string name="faq_unrecognized_sms_question">Nini hutokea kwa SMS zisizotambuliwa?</string>
    <string name="faq_unrecognized_sms_answer">Huhifadhiwa kwenye \'Ujumbe Usiotambuliwa\' ambapo unaweza kuzikagua mwenyewe au kuziripoti ili kutusaidia kuboresha usomaji.</string>
    <string name="faq_duplicates_question">Kwa nini baadhi ya miamala inajirudia?</string>
    <string name="faq_duplicates_answer">Baadhi ya benki hutuma SMS kadhaa kwa muamala mmoja. App hujaribu kutambua nakala rudufu, lakini unaweza kufuta mwenyewe zozote zinazopita.</string>
    <string name="faq_privacy_section">Faragha &amp; Data</string>
    <string name="faq_data_secure_question">Je, data yangu ya kifedha iko salama?</string>
    <string name="faq_data_secure_answer">Ndiyo! Data yote inabaki kwenye kifaa chako. Hatuna seva wala hifadhi ya wingu. Modeli ya AI inaendeshwa kwenye simu yako kwa faragha kamili.</string>
    <string name="faq_backup_question">Je, naweza kuhifadhi nakala ya data yangu?</string>
    <string name="faq_backup_answer">Kwa sasa, data inahifadhiwa kwenye kifaa tu. Vipengele vya kuhamisha/kuhifadhi nakala vimepangwa kwa masasisho yajayo.</string>
    <string name="faq_data_access_question">App inafikia data gani?</string>
    <string name="faq_data_access_answer">SMS kutoka kwa watumaji wa benki wanaojulikana tu. Hatusomi ujumbe binafsi wala kufikia data ya app nyingine.</string>
    <string name="faq_ai_section">Vipengele vya AI</string>
    <string name="faq_ai_download_question">Kwa nini nahitaji kupakua modeli ya AI?</string>
    <string name="faq_ai_download_answer">Modeli ya 750MB inawezesha gumzo kuhusu matumizi yako kwenye kifaa bila kutuma data kwa seva yoyote, hivyo faragha kamili.</string>
    <string name="faq_ai_ask_question">Naweza kumuuliza msaidizi wa AI nini?</string>
    <string name="faq_ai_ask_answer">Unaweza kuuliza kuhusu mwenendo wa matumizi, ushauri wa bajeti, muhtasari wa miamala, na maswali ya jumla ya kifedha kulingana na data yako.</string>
    <string name="faq_accounts_section">Usimamizi wa Akaunti</string>
    <string name="faq_manual_accounts_question">Akaunti za mkono ni nini?</string>
    <string name="faq_manual_accounts_answer">Akaunti za mkono zinakuwezesha kufuatilia pesa taslimu, uwekezaji, au akaunti za benki zisizoungwa mkono. Unasasisha salio mwenyewe.</string>
    <string name="faq_multiple_accounts_question">Nifuatilie vipi akaunti kadhaa za benki moja?</string>
    <string name="faq_multiple_accounts_answer">App hutambua akaunti tofauti yenyewe kwa kutumia tarakimu 4 za mwisho zinazoonyeshwa kwenye SMS.</string>
    <string name="faq_still_need_help_section">Bado Unahitaji Msaada?</string>
    <string name="faq_report_issue_title">Ripoti Tatizo</string>
    <string name="faq_report_issue_subtitle">Tuma ripoti za hitilafu, maombi ya benki, au mapendekezo ya vipengele kwenye GitHub</string>
</resources>
