<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- TODO: Use <include> and <exclude> to control what is backed up.
        <include .../>
        <exclude .../>
        -->
    </cloud-backup>
    <device-transfer>
        <!-- Do not copy the financial database on device-to-device transfer.
             allowBackup="false" alone does not disable D2D transfer on Android
             12+ when no explicit rules exist. -->
        <exclude domain="database" path="pennywise_database" />
    </device-transfer>
</data-extraction-rules>