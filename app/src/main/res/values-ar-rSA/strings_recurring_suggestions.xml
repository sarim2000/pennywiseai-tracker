    <plurals name="subscription_suggestion_sheet_found">
        <item quantity="zero">تم العثور على %1$d دفعة</item>
        <item quantity="one">تم العثور على %1$d دفعة</item>
        <item quantity="two">تم العثور على %1$d دفعتين</item>
        <item quantity="few">تم العثور على %1$d دفعات</item>
        <item quantity="many">تم العثور على %1$d دفعة</item>
        <item quantity="other">تم العثور على %1$d دفعة</item>
    </plurals>
    <!-- %1$s: currency code, e.g. "USD" -->
    <string name="subscription_suggestion_sheet_amount">المبلغ المراد تتبعه (%1$s)</string>
    <string name="subscription_suggestion_sheet_variable_hint">يتغير مبلغ هذه الفاتورة في كل مرة. يمكنك تعديله لاحقًا.</string>
    <!-- %1$s: date, e.g. "15 Nov 2026" -->
    <string name="subscription_suggestion_sheet_next">الدفعة التالية متوقعة في %1$s</string>
    <string name="subscription_suggestion_sheet_track">تتبع الفاتورة</string>
    <string name="subscription_suggestion_sheet_helper">ستتلقى تذكيرًا قبل يوم من كل دفعة.</string>
    <!-- Snackbars. %1$s: merchant name -->
    <string name="subscriptions_suggestion_tracked">بدأ تتبع %1$s</string>
    <string name="subscriptions_suggestion_already_tracked">يتم تتبع %1$s بالفعل</string>
    <string name="subscriptions_suggestion_dismissed">لن يُقترح %1$s مرة أخرى</string>
    <!-- Home card linking to the suggestions -->
    <plurals name="home_recurring_card_title">
        <item quantity="zero">%1$d فاتورة متكررة محتملة</item>
        <item quantity="one">%1$d فاتورة متكررة محتملة</item>
        <item quantity="two">%1$d فاتورتان متكررتان محتملتان</item>
        <item quantity="few">%1$d فواتير متكررة محتملة</item>
        <item quantity="many">%1$d فاتورة متكررة محتملة</item>
        <item quantity="other">%1$d فاتورة متكررة محتملة</item>
    </plurals>
