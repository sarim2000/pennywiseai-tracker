<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Subscriptions screen: "Suggested" section listing payments that repeat in the user's history but aren't tracked yet -->
    <string name="subscriptions_suggested_section">सुझाए गए</string>
    <string name="subscriptions_suggested_hint">ऐसे भुगतान जो आपकी हिस्ट्री में बार-बार आते हैं। ट्रैक करने तक इन्हें गिना नहीं जाता।</string>
    <!-- %1$d: total number of suggestions -->
    <string name="subscriptions_suggested_show_all">सभी देखें (%1$d)</string>
    <string name="subscriptions_suggested_show_less">कम देखें</string>
    <!-- Suggestion row: "%1$s · %2$s" = billing cycle (e.g. "Monthly") · payment count (subscription_suggestion_payments) -->
    <plurals name="subscription_suggestion_payments">
        <item quantity="one">%1$d भुगतान</item>
        <item quantity="other">%1$d भुगतान</item>
    </plurals>
    <!-- Amount range of a bill whose amount changes. %1$s lowest amount, %2$s highest amount, both with currency -->
    <string name="subscription_suggestion_varies">राशि बदलती है</string>
    <string name="subscription_suggestion_review">देखें</string>
    <string name="subscription_suggestion_not_recurring">आवर्ती नहीं</string>
    <!-- Review sheet. %1$s billing cycle (e.g. "Monthly"), %2$s category -->
    <plurals name="subscription_suggestion_sheet_found">
        <item quantity="one">%1$d भुगतान मिला</item>
        <item quantity="other">%1$d भुगतान मिले</item>
    </plurals>
    <!-- %1$s: currency code, e.g. "USD" -->
    <string name="subscription_suggestion_sheet_amount">ट्रैक करने की राशि (%1$s)</string>
    <string name="subscription_suggestion_sheet_variable_hint">यह बिल हर बार बदलता है। आप राशि बाद में बदल सकते हैं।</string>
    <!-- %1$s: date, e.g. "15 Nov 2026" -->
    <string name="subscription_suggestion_sheet_next">अगला भुगतान %1$s को अपेक्षित</string>
    <string name="subscription_suggestion_sheet_track">बिल ट्रैक करें</string>
    <string name="subscription_suggestion_sheet_helper">हर भुगतान से एक दिन पहले आपको रिमाइंडर मिलेगा।</string>
    <!-- Snackbars. %1$s: merchant name -->
    <string name="subscriptions_suggestion_tracked">%1$s अब ट्रैक हो रहा है</string>
    <string name="subscriptions_suggestion_already_tracked">%1$s पहले से ट्रैक हो रहा है</string>
    <string name="subscriptions_suggestion_dismissed">%1$s फिर से सुझाया नहीं जाएगा</string>
    <!-- Home card linking to the suggestions -->
    <plurals name="home_recurring_card_title">
        <item quantity="one">%1$d संभावित आवर्ती बिल</item>
        <item quantity="other">%1$d संभावित आवर्ती बिल</item>
    </plurals>
    <!-- %1$s: one or two merchant names, comma-separated -->
    <string name="home_recurring_card_body">%1$s। हर भुगतान से पहले रिमाइंडर पाने के लिए देखें।</string>
    <!-- %1$s: two merchant names, comma-separated; %2$d: how many more, shown as "+2" -->
    <string name="home_recurring_card_body_more">%1$s +%2$d। हर भुगतान से पहले रिमाइंडर पाने के लिए देखें।</string>
    <string name="home_recurring_card_action">देखें</string>
    <string name="home_recurring_card_dismiss">छिपाएँ</string>
</resources>
