<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Home: the section, its title in Edit home, and the menu entry -->
    <string name="home_section_insights">Insights</string>

    <!-- Insights screen -->
    <string name="insights_title">Insights</string>
    <string name="insights_back">Back</string>
    <string name="insights_this_cycle">This cycle</string>
    <string name="insights_spent">Spent</string>
    <string name="insights_income">Income</string>
    <string name="insights_saved">Saved</string>
    <string name="insights_savings_rate">Savings rate</string>
    <!-- What active subscriptions cost a month, beside this cycle's figures -->
    <string name="insights_subscriptions_monthly">Subscriptions a month</string>
    <!-- How long the money in savings, current and cash accounts would last at a usual month's spending -->
    <string name="insights_runway">Money would last</string>
    <!-- Some balances are estimates. %1$s = a number of months, e.g. "2.4 months" -->
    <string name="insights_runway_about">about %1$s</string>
    <!-- %1$s = a number of months with one decimal, e.g. "2.4" -->
    <string name="insights_months_decimal">%1$s months</string>
    <!-- %1$s = a whole number of months -->
    <plurals name="insights_months">
        <item quantity="one">%1$s month</item>
        <item quantity="other">%1$s months</item>
    </plurals>
    <string name="insights_months_under_one">under a month</string>
    <string name="insights_last_cycles">Spending by cycle</string>
    <string name="insights_section_alert">Needs attention</string>
    <string name="insights_section_warning">Heads up</string>
    <string name="insights_section_good">Doing well</string>
    <string name="insights_all_clear">Nothing needs your attention right now.</string>
    <string name="insights_empty_headline">Insights are on their way</string>
    <string name="insights_empty_body">Once a few weeks of transactions are in, this page shows what needs attention and what\'s going well.</string>
    <!-- Empty page for someone with earlier transactions, early in a new cycle -->
    <string name="insights_quiet_headline">Nothing recorded this cycle yet</string>
    <string name="insights_quiet_body">Insights for this cycle show up here as transactions come in.</string>
    <string name="insights_coverage">Worked out on this phone from your recorded transactions. Nothing is sent anywhere.</string>
    <string name="insights_dismiss">Dismiss</string>
    <string name="insights_dismissed">Insight dismissed</string>
    <string name="insights_undo">Undo</string>
    <string name="insights_restore">Show again</string>
    <!-- Under the title of an insight the user dismissed, in the "Show dismissed" list -->
    <string name="insights_dismissed_label">Dismissed</string>
    <!-- %1$d = how many insights were dismissed this cycle -->
    <string name="insights_show_dismissed">Show dismissed (%1$d)</string>
    <string name="insights_hide_dismissed">Hide dismissed</string>
    <!-- Under the first few heads-ups. %1$d = how many more there are -->
    <plurals name="insights_show_more">
        <item quantity="one">Show %1$d more</item>
        <item quantity="other">Show %1$d more</item>
    </plurals>
    <string name="insights_show_fewer">Show fewer</string>
    <string name="insights_expand">Show details</string>
    <string name="insights_collapse">Hide details</string>
    <!-- %1$d = a whole percentage -->
    <string name="insights_percent">%1$d%%</string>

    <!-- Tracking health: a 0-100 indicator of how the cycle is going and being tracked -->
    <string name="insights_score_title">Tracking health</string>
    <string name="insights_score_out_of">out of 100</string>
    <!-- %1$s = the parts the score is built from this cycle, as a list, e.g. "your savings and how much is categorised" -->
    <string name="insights_score_hint">From %1$s. Tap to see how.</string>
    <!-- The parts listed in insights_score_hint -->
    <string name="insights_score_hint_savings">your savings</string>
    <string name="insights_score_hint_budgets">your budgets</string>
    <string name="insights_score_hint_categorised">how much is categorised</string>
    <string name="insights_score_breakdown_title">How tracking health is worked out</string>
    <string name="insights_score_savings">Savings</string>
    <!-- %1$s = percentage of income kept -->
    <string name="insights_score_savings_detail">%1$s of income kept. A fifth or more gets full marks.</string>
    <!-- More went out than came in. %1$s = how much more, as a percentage of income -->
    <string name="insights_score_savings_detail_negative">You spent %1$s more than you earned. Keeping a fifth of income gets full marks.</string>
    <string name="insights_score_budgets">Budgets</string>
    <!-- %1$d = budgets on track, %2$d = all budgets -->
    <plurals name="insights_score_budgets_detail">
        <item quantity="one">%1$d of %2$d budget on track</item>
        <item quantity="other">%1$d of %2$d budgets on track</item>
    </plurals>
    <string name="insights_score_categorised">Categorised</string>
    <!-- %1$d = spends with a category, %2$d = all spends -->
    <plurals name="insights_score_categorised_detail">
        <item quantity="one">%1$d of %2$d spend has a category</item>
        <item quantity="other">%1$d of %2$d spends have a category</item>
    </plurals>
    <!-- %1$d = points for one part -->
    <string name="insights_score_points">%1$d/100</string>
    <!-- Under a score part. %1$s = how much it counts toward the score, as a percentage -->
    <string name="insights_score_share">Counts for %1$s of the score</string>
    <!-- The savings part while amounts are hidden: no rate, and no hint whether it's below zero -->
    <string name="insights_score_savings_detail_hidden">Share of income kept. A fifth or more gets full marks.</string>
    <string name="insights_score_footnote">The score adds up each part\'s points by how much it counts. A part without data is left out and the others count for more. Dismissing an insight doesn\'t change it.</string>

    <!-- Metric labels on an expanded insight -->
    <string name="insights_metric_spent">Spent</string>
    <string name="insights_metric_budget">Budget</string>
    <string name="insights_metric_projected">Projected</string>
    <string name="insights_metric_usual">Usual</string>
    <string name="insights_metric_this_cycle">This cycle</string>
    <string name="insights_metric_amount">Amount</string>
    <string name="insights_metric_income">Income</string>
    <string name="insights_metric_saved">Saved</string>
    <string name="insights_metric_used">Used</string>
    <string name="insights_metric_limit">Limit</string>
    <string name="insights_metric_tracked">Tracked at</string>
    <string name="insights_metric_charged">Charged</string>
    <string name="insights_metric_held">In accounts</string>
    <string name="insights_metric_usual_month">Usual month</string>
    <string name="insights_metric_goals_need">Goals need</string>
    <string name="insights_metric_left_over">Usually left over</string>

    <!-- Action buttons -->
    <string name="insights_action_budgets">Open budgets</string>
    <string name="insights_action_transactions">See transactions</string>
    <string name="insights_action_transaction">Open transaction</string>
    <string name="insights_action_subscriptions">Open subscriptions</string>
    <string name="insights_action_account">Open account</string>
    <string name="insights_action_goals">Open goals</string>

    <!-- Budget over. %1$s = amount over, %2$s = budget name (often already ends in "Budget", so don't add the word) -->
    <string name="insights_budget_over_title">%1$s over on %2$s</string>
    <!-- Budget limit reached with days still to go. %1$s = budget name -->
    <string name="insights_budget_used_up_title">Nothing left in %1$s</string>
    <!-- Budget pace. %1$s = amount per day, %2$s = budget name -->
    <string name="insights_budget_pace_title">%1$s a day keeps %2$s on track</string>
    <!-- %1$s = the budget period's end date -->
    <string name="insights_budget_pace_body">At this pace you\'d go over it before %1$s.</string>
    <string name="insights_budget_incomplete">Some spending in other currencies has no exchange rate yet, so the real figure may be higher.</string>
    <plurals name="insights_budgets_on_track_title">
        <item quantity="one">%1$d budget is on track</item>
        <item quantity="other">All %1$d budgets are on track</item>
    </plurals>
    <string name="insights_budgets_on_track_body">Spending is at or under an even pace for the rest of the period.</string>

    <!-- Category spike. %1$s = amount, %2$s = category, %3$s = percentage -->
    <string name="insights_spike_title">%1$s on %2$s, %3$s more than usual</string>
    <!-- Under a category spike: the usual figure is for a whole cycle -->
    <string name="insights_spike_body">Usual is for a whole cycle, and this one isn\'t over yet.</string>

    <!-- Savings rate. %1$s = percentage -->
    <string name="insights_savings_good_title">You\'ve kept %1$s of your income</string>
    <!-- Under either savings insight -->
    <string name="insights_savings_body">So far this cycle.</string>
    <!-- %1$s = amount -->
    <string name="insights_savings_negative_title">%1$s more spent than earned</string>

    <!-- Large transaction. %1$s = amount, %2$s = merchant, %3$s = how many times, e.g. "4×" -->
    <string name="insights_large_title">%1$s at %2$s, %3$s your usual</string>
    <!-- %1$d = how many times the usual amount (3 or more) -->
    <plurals name="insights_times">
        <item quantity="one">%1$d×</item>
        <item quantity="other">%1$d×</item>
    </plurals>
    <!-- %1$s = category, %2$s = date -->
    <string name="insights_large_body">Usual is a typical %1$s spend. This one was on %2$s.</string>

    <!-- Price change. %1$s = subscription name, %2$s = new amount -->
    <string name="insights_price_title">%1$s charged %2$s</string>
    <string name="insights_price_body">Update it so upcoming bills stay right.</string>

    <!-- Card utilisation. %1$s = percentage, %2$s = card name -->
    <string name="insights_card_title">%1$s of your %2$s limit used</string>

    <!-- Runway. %1$s = how long, e.g. "2.4 months", "about 2.4 months" (some balances unknown) or "under a month" -->
    <string name="insights_runway_title">Your money would last %1$s</string>
    <!-- %1$s = money in savings, current and cash accounts, %2$s = a usual month's spending, %3$d = months many aim for -->
    <string name="insights_runway_low_body">That\'s %1$s in your accounts against %2$s spent in a usual month. Many people aim for %3$d months.</string>
    <!-- %1$s = money in savings, current and cash accounts, %2$s = a usual month's spending, %3$d = months many aim for -->
    <string name="insights_runway_good_body">That\'s %1$s in your accounts against %2$s spent in a usual month, past the %3$d months many people aim for.</string>
    <string name="insights_runway_estimate">Some accounts are left out because their balance isn\'t known yet. Update them in Accounts for a truer figure.</string>

    <!-- Goals fit what a usual month leaves over. %1$s = what all goals in progress need a month -->
    <string name="insights_goals_fit_title">%1$s a month reaches all your goals</string>
    <!-- %1$s = what a usual month leaves over -->
    <string name="insights_goals_fit_body">A usual month leaves you about %1$s, so they fit.</string>
    <!-- Goals need more than a usual month leaves. %1$s = the gap a month -->
    <string name="insights_goals_short_title">Your goals need %1$s more a month</string>
    <!-- %1$s = what all goals in progress need a month, %2$s = what a usual month leaves over -->
    <string name="insights_goals_short_body">They need %1$s a month together, and a usual month leaves about %2$s.</string>
    <!-- A usual month spends all its income or more. %1$s = what all goals in progress need a month -->
    <string name="insights_goals_no_surplus_body">They need %1$s a month together, but a usual month spends all that comes in.</string>

    <!-- Bills due. %1$s = total, %2$d = days -->
    <plurals name="insights_bills_title">
        <item quantity="one">%1$s due in the next %2$d day</item>
        <item quantity="other">%1$s due in the next %2$d days</item>
    </plurals>
    <!-- %1$s = the subscriptions due, soonest first, as a list ("Spotify and Netflix"), %2$s = date of the first -->
    <plurals name="insights_bills_body">
        <item quantity="one">%1$s, on %2$s.</item>
        <item quantity="other">%1$s. The first is on %2$s.</item>
    </plurals>
    <!-- The first is due today. %1$s = the subscriptions due, soonest first, as a list -->
    <plurals name="insights_bills_body_today">
        <item quantity="one">%1$s, due today.</item>
        <item quantity="other">%1$s. The first is due today.</item>
    </plurals>
</resources>
