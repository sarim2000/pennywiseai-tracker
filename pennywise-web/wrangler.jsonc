{
	"name": "pennywise-web",
	"main": "src/worker.js",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"routes": [
		{
			"pattern": "pennywise.zynth.dev",
			"zone_name": "zynth.dev",
			"custom_domain": true
		}
	],
	// /static/* is served from Cloudflare's edge without invoking the Worker. deploy.sh
	// copies server/src/main/resources/static into public/static (gitignored), so the
	// Ktor resources stay the single source; public/_headers sets their Cache-Control.
	// Paths with no file there (every page) fall through to the Worker.
	"assets": {
		"directory": "./public"
	},
	// Its id changes on every deploy; the page cache keys on it (src/edge-cache.js).
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	"observability": {
		"enabled": true
	},
	"containers": [
		{
			"class_name": "PennyWiseContainer",
			"image": "./Dockerfile",
			"max_instances": 10
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "PennyWiseContainer",
				"name": "PENNYWISE_CONTAINER"
			}
		]
	},
	"migrations": [
		{
			"new_sqlite_classes": [
				"PennyWiseContainer"
			],
			"tag": "v1"
		}
	],
	"vars": {
		"KTOR_ENV": "production"
	},
	"workers_dev": true,
	"preview_urls": true
}