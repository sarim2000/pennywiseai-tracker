    <!-- Budget over. %1$s = amount over, %2$s = budget name -->
    <string name="insights_budget_over_title">%1$s over your %2$s budget</string>
    <!-- %1$s = spent, %2$s = budget limit -->
    <string name="insights_budget_over_body">You\'ve spent %1$s of %2$s.</string>
    <!-- Budget pace. %1$s = amount per day, %2$s = budget name -->
    <string name="insights_budget_pace_title">%1$s a day keeps %2$s on budget</string>
    <!-- %1$s = projected spend, %2$s = end date, %3$s = budget limit -->
    <string name="insights_budget_pace_body">At this pace you\'d spend %1$s by %2$s, against a budget of %3$s.</string>
    <string name="insights_budget_incomplete">Some spending in other currencies has no exchange rate yet, so the real figure may be higher.</string>
    <plurals name="insights_budgets_on_track_title">
        <item quantity="one">%1$d budget is on track</item>
        <item quantity="other">All %1$d budgets are on track</item>
    </plurals>
    <string name="insights_budgets_on_track_body">Spending is at or under an even pace for the rest of the period.</string>

    <!-- Category spike. %1$s = amount, %2$s = category, %3$s = percentage -->
    <string name="insights_spike_title">%1$s on %2$s, %3$s more than usual</string>
    <!-- %1$s = usual amount for a whole cycle -->
    <string name="insights_spike_body">You usually spend about %1$s on it in a whole cycle, and this one isn\'t over yet.</string>

    <!-- Savings rate. %1$s = percentage -->
    <string name="insights_savings_good_title">You\'ve kept %1$s of your income</string>
    <!-- %1$s = amount saved, %2$s = income -->
    <string name="insights_savings_good_body">%1$s of %2$s so far this cycle.</string>
    <!-- %1$s = amount -->
    <string name="insights_savings_negative_title">%1$s more spent than earned</string>
    <!-- %1$s = income -->
    <string name="insights_savings_negative_body">Income recorded so far this cycle is %1$s.</string>

    <!-- Large transaction. %1$s = amount, %2$s = merchant, %3$d = how many times -->
    <string name="insights_large_title">%1$s at %2$s, %3$d× your usual</string>
    <!-- %1$s = category, %2$s = typical amount, %3$s = date -->
    <string name="insights_large_body">A typical %1$s spend is about %2$s. This one was on %3$s.</string>

    <!-- Price change. %1$s = subscription name, %2$s = new amount -->
    <string name="insights_price_title">%1$s charged %2$s</string>
    <!-- %1$s = tracked amount -->
    <string name="insights_price_body">You track it at %1$s. Update it so upcoming bills stay right.</string>

    <!-- Subscription cost. %1$s = monthly amount -->
    <string name="insights_subscriptions_title">Subscriptions cost %1$s a month</string>
    <plurals name="insights_subscriptions_body">
        <item quantity="one">Across %1$d subscription.</item>
        <item quantity="other">Across %1$d subscriptions.</item>
    </plurals>

