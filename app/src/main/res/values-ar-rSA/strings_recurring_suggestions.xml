<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Subscriptions screen: "Suggested" section listing payments that repeat in the user's history but aren't tracked yet -->
    <string name="subscriptions_suggested_section">مقترحة</string>
    <string name="subscriptions_suggested_hint">دفعات تتكرر في سجلك. لا تُحتسب حتى تبدأ بتتبعها.</string>
    <!-- %1$d: total number of suggestions -->
    <string name="subscriptions_suggested_show_all">عرض الكل (%1$d)</string>
    <string name="subscriptions_suggested_show_less">عرض أقل</string>
    <!-- Suggestion row: "%1$s · %2$s" = billing cycle (e.g. "Monthly") · payment count (subscription_suggestion_payments) -->
    <plurals name="subscription_suggestion_payments">
        <item quantity="zero">%1$d دفعة</item>
        <item quantity="one">%1$d دفعة</item>
        <item quantity="two">%1$d دفعتان</item>
        <item quantity="few">%1$d دفعات</item>
        <item quantity="many">%1$d دفعة</item>
        <item quantity="other">%1$d دفعة</item>
    </plurals>
    <!-- Amount range of a bill whose amount changes. %1$s lowest amount, %2$s highest amount, both with currency -->
    <string name="subscription_suggestion_varies">المبلغ متغير</string>
    <string name="subscription_suggestion_review">مراجعة</string>
    <string name="subscription_suggestion_not_recurring">غير متكررة</string>
