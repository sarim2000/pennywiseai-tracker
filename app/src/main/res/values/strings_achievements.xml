<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Achievements screen -->
    <string name="achievements_title">Achievements</string>
    <string name="achievements_load_failed">Couldn\'t work out your achievements.</string>
    <string name="achievements_back">Back</string>
    <string name="achievements_share_all">Share all</string>
    <!-- %1$s = an achievement's name -->
    <string name="achievements_share_one">Share %1$s</string>
    <!-- %1$d = achievements earned, %2$d = all achievements -->
    <string name="achievements_summary">%1$d of %2$d earned</string>
    <string name="achievements_summary_hint">Worked out on your phone from what you\'ve tracked. Nothing extra is stored.</string>
    <string name="achievements_section_earned">Earned</string>
    <string name="achievements_section_locked">Still to earn</string>
    <!-- %1$d = tiers earned, %2$d = all tiers -->
    <string name="achievements_tier">Tier %1$d of %2$d</string>
    <!-- %1$s = a date -->
    <string name="achievements_earned_on">Earned %1$s</string>
    <!-- Progress toward a tier. %1$s = where you are, %2$s = what it takes, e.g. "120 / 500" -->
    <string name="achievements_progress">%1$s / %2$s</string>

    <!-- Each achievement: a name, and what its tier asks for, said as done -->
    <string name="achievement_tracked_name">Bookkeeper</string>
    <!-- %1$s = a number of transactions -->
    <plurals name="achievement_tracked_desc">
        <item quantity="one">%1$s transaction tracked</item>
        <item quantity="other">%1$s transactions tracked</item>
    </plurals>
    <string name="achievement_streak_name">Steady habit</string>
    <!-- %1$s = a number of months -->
    <plurals name="achievement_streak_desc">
        <item quantity="one">Tracked %1$s month</item>
        <item quantity="other">Tracked %1$s months in a row</item>
    </plurals>
    <string name="achievement_goals_reached_name">Goal getter</string>
    <!-- %1$s = a number of goals -->
    <plurals name="achievement_goals_reached_desc">
        <item quantity="one">Reached %1$s goal</item>
        <item quantity="other">Reached %1$s goals</item>
    </plurals>
</resources>
