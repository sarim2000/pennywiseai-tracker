<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Subscriptions screen: "Suggested" section listing payments that repeat in the user's history but aren't tracked yet -->
    <string name="subscriptions_suggested_section">Vorschläge</string>
    <string name="subscriptions_suggested_hint">Zahlungen, die sich in Ihrem Verlauf wiederholen. Sie werden erst gezählt, wenn Sie sie verfolgen.</string>
    <!-- %1$d: total number of suggestions -->
    <string name="subscriptions_suggested_show_all">Alle anzeigen (%1$d)</string>
    <string name="subscriptions_suggested_show_less">Weniger anzeigen</string>
    <!-- Suggestion row: "%1$s · %2$s" = billing cycle (e.g. "Monthly") · payment count (subscription_suggestion_payments) -->
    <plurals name="subscription_suggestion_payments">
        <item quantity="one">%1$d Zahlung</item>
        <item quantity="other">%1$d Zahlungen</item>
    </plurals>
    <!-- Amount range of a bill whose amount changes. %1$s lowest amount, %2$s highest amount, both with currency -->
    <string name="subscription_suggestion_varies">Betrag variiert</string>
    <string name="subscription_suggestion_review">Prüfen</string>
    <string name="subscription_suggestion_not_recurring">Nicht regelmäßig</string>
    <!-- Review sheet. %1$s billing cycle (e.g. "Monthly"), %2$s category -->
    <plurals name="subscription_suggestion_sheet_found">
        <item quantity="one">%1$d Zahlung gefunden</item>
        <item quantity="other">%1$d Zahlungen gefunden</item>
    </plurals>
    <!-- %1$s: currency code, e.g. "USD" -->
    <string name="subscription_suggestion_sheet_amount">Zu verfolgender Betrag (%1$s)</string>
    <string name="subscription_suggestion_sheet_variable_hint">Diese Rechnung ändert sich jedes Mal. Sie können den Betrag später bearbeiten.</string>
    <!-- %1$s: date, e.g. "15 Nov 2026" -->
    <string name="subscription_suggestion_sheet_next">Nächste Zahlung erwartet am %1$s</string>
    <string name="subscription_suggestion_sheet_track">Rechnung verfolgen</string>
    <string name="subscription_suggestion_sheet_helper">Sie erhalten am Tag vor jeder Zahlung eine Erinnerung.</string>
    <!-- Snackbars. %1$s: merchant name -->
    <string name="subscriptions_suggestion_tracked">%1$s wird jetzt verfolgt</string>
    <string name="subscriptions_suggestion_already_tracked">%1$s wird bereits verfolgt</string>
    <string name="subscriptions_suggestion_dismissed">%1$s wird nicht mehr vorgeschlagen</string>
    <!-- Home card linking to the suggestions -->
    <plurals name="home_recurring_card_title">
        <item quantity="one">%1$d mögliche wiederkehrende Rechnung</item>
        <item quantity="other">%1$d mögliche wiederkehrende Rechnungen</item>
    </plurals>
    <!-- %1$s: one or two merchant names, comma-separated -->
    <string name="home_recurring_card_body">%1$s. Prüfen Sie sie, um vor jeder Zahlung erinnert zu werden.</string>
    <!-- %1$s: two merchant names, comma-separated; %2$d: how many more, shown as "+2" -->
    <string name="home_recurring_card_body_more">%1$s +%2$d. Prüfen Sie sie, um vor jeder Zahlung erinnert zu werden.</string>
    <string name="home_recurring_card_action">Prüfen</string>
    <string name="home_recurring_card_dismiss">Verstecken</string>
</resources>
