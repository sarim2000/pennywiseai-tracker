<?xml version="1.0" encoding="utf-8"?>
<!--
    The Conscience screen, the "Liked it" action and its confirmations. Only an app
    language with its own conscience_lines.xml shows them, so this file isn't named
    strings*.xml and stays out of Crowdin, the same as the lines: no translator works
    on a screen nobody in their language can open. Move these into strings_conscience.xml
    once the conscience reaches a language that Crowdin translates.
-->
<resources>
    <!-- The row on the Notifications page that opens the screen -->
    <string name="conscience_nav_subtitle_on">On · cheeky comments on your spending</string>
    <string name="conscience_nav_subtitle_off">Off · cheeky comments on your spending</string>

    <!-- The hero card at the top of the screen -->
    <string name="conscience_hero_title">Your spending has a commentator</string>
    <string name="conscience_hero_body">Cheeky one-liners after food, fun and shopping. And applause when it\'s earned.</string>
    <string name="conscience_switch_title">Let it talk</string>

    <!-- Status line under the switch -->
    <string name="conscience_status_off">Napping. Flip the switch to wake it up 😴</string>
    <string name="conscience_status_blocked">Notifications are off, so it\'s talking to a wall 🧱</string>
    <string name="conscience_status_listening">Listening for your next food, fun or shopping purchase 👂</string>
    <string name="conscience_status_learning">Still learning your habits. The sharper remarks unlock as your history grows 🧠</string>
    <string name="conscience_open_notification_settings">Turn on notifications</string>

    <!-- Examples -->
    <string name="conscience_examples_title">Overheard examples</string>
