<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview for the 2x2 Challenge widget: two days clean, one missed,
     today still to settle, three to come. Theme.Pennywisecompose has a night variant.
     android:tint, not app:tint: a picker preview is RemoteViews, which has no AppCompat.
     The days to come are a dimmed solid tint: a translucent tint (colorControlHighlight)
     drew them solid white in the dark picker. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="16dp"
    android:theme="@style/Theme.Pennywisecompose"
    tools:ignore="UseAppTint">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/widget_challenge_preview_title"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginVertical="8dp"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_dot"
            android:tint="?android:attr/colorAccent" />
        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="4dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_dot"
            android:tint="?android:attr/colorAccent" />
        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="4dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_close"
            android:tint="?android:attr/textColorSecondary" />
        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="4dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_ring"
            android:tint="?android:attr/colorAccent" />
        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="4dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_dot"
            android:alpha="0.3"
            android:tint="?android:attr/textColorSecondary" />
        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="4dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_dot"
            android:alpha="0.3"
            android:tint="?android:attr/textColorSecondary" />
        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="4dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_dot"
            android:alpha="0.3"
            android:tint="?android:attr/textColorSecondary" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/widget_challenge_preview_done"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/widget_challenge_preview_left"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="12sp" />
</LinearLayout>
