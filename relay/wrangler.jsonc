// PennyWise AI relay (ADR 0002). Passes MCP tool calls to the phone; stores and logs no money data.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pennywise-ai-relay",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-01",
	// CIMD: the OAuth library fetches client metadata documents and must never reach private addresses.
	"compatibility_flags": ["global_fetch_strictly_public"],
	"routes": [{ "pattern": "ai.pennywise.zynth.dev", "custom_domain": true }],
	"vars": { "BASE_URL": "https://ai.pennywise.zynth.dev" },
	// Create with: npx wrangler kv namespace create OAUTH_KV — then paste the id here.
	"kv_namespaces": [{ "binding": "OAUTH_KV", "id": "REPLACE_WITH_KV_ID" }],
	"durable_objects": { "bindings": [{ "name": "PHONE", "class_name": "Phone" }] },
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["Phone"] }],
	"ratelimits": [
		{ "name": "PAIR_LIMIT", "namespace_id": "71001", "simple": { "limit": 10, "period": 60 } },
		{ "name": "REGISTER_LIMIT", "namespace_id": "71002", "simple": { "limit": 5, "period": 60 } },
		{ "name": "MCP_LIMIT", "namespace_id": "71003", "simple": { "limit": 120, "period": 60 } }
	],
	"observability": { "enabled": true, "logs": { "invocation_logs": false } }
}
