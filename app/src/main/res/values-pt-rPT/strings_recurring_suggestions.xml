<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Subscriptions screen: "Suggested" section listing payments that repeat in the user's history but aren't tracked yet -->
    <string name="subscriptions_suggested_section">Sugestões</string>
    <string name="subscriptions_suggested_hint">Pagamentos que se repetem no seu histórico. Só são contabilizados depois de os acompanhar.</string>
    <!-- %1$d: total number of suggestions -->
    <string name="subscriptions_suggested_show_all">Ver todas (%1$d)</string>
    <string name="subscriptions_suggested_show_less">Ver menos</string>
    <!-- Suggestion row: "%1$s · %2$s" = billing cycle (e.g. "Monthly") · payment count (subscription_suggestion_payments) -->
    <plurals name="subscription_suggestion_payments">
        <item quantity="one">%1$d pagamento</item>
        <item quantity="other">%1$d pagamentos</item>
    </plurals>
    <!-- Amount range of a bill whose amount changes. %1$s lowest amount, %2$s highest amount, both with currency -->
    <string name="subscription_suggestion_varies">Valor variável</string>
    <string name="subscription_suggestion_review">Rever</string>
    <string name="subscription_suggestion_not_recurring">Não é recorrente</string>
    <!-- Review sheet. %1$s billing cycle (e.g. "Monthly"), %2$s category -->
    <plurals name="subscription_suggestion_sheet_found">
        <item quantity="one">%1$d pagamento encontrado</item>
        <item quantity="other">%1$d pagamentos encontrados</item>
    </plurals>
    <!-- %1$s: currency code, e.g. "USD" -->
    <string name="subscription_suggestion_sheet_amount">Valor a acompanhar (%1$s)</string>
    <string name="subscription_suggestion_sheet_variable_hint">Esta fatura muda de cada vez. Pode editar o valor mais tarde.</string>
    <!-- %1$s: date, e.g. "15 Nov 2026" -->
    <string name="subscription_suggestion_sheet_next">Próximo pagamento previsto a %1$s</string>
    <string name="subscription_suggestion_sheet_track">Acompanhar fatura</string>
    <string name="subscription_suggestion_sheet_helper">Irá receber um lembrete na véspera de cada pagamento.</string>
    <!-- Snackbars. %1$s: merchant name -->
    <string name="subscriptions_suggestion_tracked">A acompanhar %1$s</string>
    <string name="subscriptions_suggestion_already_tracked">%1$s já está a ser acompanhada</string>
    <string name="subscriptions_suggestion_dismissed">%1$s não voltará a ser sugerida</string>
    <!-- Home card linking to the suggestions -->
    <plurals name="home_recurring_card_title">
        <item quantity="one">%1$d possível fatura recorrente</item>
        <item quantity="other">%1$d possíveis faturas recorrentes</item>
    </plurals>
    <!-- %1$s: one or two merchant names, comma-separated -->
    <string name="home_recurring_card_body">%1$s. Reveja para receber um lembrete antes de cada pagamento.</string>
    <!-- %1$s: two merchant names, comma-separated; %2$d: how many more, shown as "+2" -->
    <string name="home_recurring_card_body_more">%1$s +%2$d. Reveja para receber um lembrete antes de cada pagamento.</string>
    <string name="home_recurring_card_action">Rever</string>
    <string name="home_recurring_card_dismiss">Esconder</string>
</resources>
