    <!-- Transaction Types -->
    <string name="faq_transaction_types_section">Tipos de transacciones</string>
    <string name="faq_wallet_credit_question">¿Por qué las transacciones de billeteras aparecen como Crédito?</string>
    <string name="faq_wallet_credit_answer">Las transacciones de billeteras (Amazon Pay, Paytm, etc.) se marcan como Crédito porque primero se cargan a tu cuenta bancaria o tarjeta de crédito, no son débitos bancarios directos. Así se sigue el medio de pago que realmente usaste.</string>
    <string name="faq_transaction_types_question">¿Cuál es la diferencia entre los 5 tipos de transacciones?</string>
    <string name="faq_transaction_types_answer">• Gasto: dinero que sale de tu cuenta (débitos, compras, pagos de facturas)\n• Ingreso: dinero que entra a tu cuenta (sueldo, reembolsos, cashback)\n• Inversión: fondos de inversión, acciones, SIP, cuentas de trading\n• Crédito: transacciones con tarjeta de crédito y pagos con billeteras (dinero que pagarás después)\n• Transferencia: dinero que mueves entre tus propias cuentas</string>
    <string name="faq_transfer_vs_expense_question">¿Cuándo uso Transferencia y cuándo Gasto?</string>
    <string name="faq_transfer_vs_expense_answer">Usa Transferencia cuando muevas dinero entre tus propias cuentas (p. ej., de ahorros a la cuenta corriente). No afecta tu patrimonio neto. Usa Gasto para lo que realmente gastas.</string>
    <!-- SMS Parsing -->
    <string name="faq_sms_parsing_section">Lectura de SMS</string>
    <string name="faq_sms_not_detected_question">¿Por qué no se detectan los SMS de mi banco?</string>
    <string name="faq_sms_not_detected_answer">Revisa si tu banco está en nuestra lista de bancos compatibles. Si no, repórtalo en GitHub. Asegúrate de haber dado el permiso de SMS y de que el formato del remitente coincida con los patrones habituales de SMS bancarios.</string>
    <string name="faq_unrecognized_sms_question">¿Qué pasa con los SMS no reconocidos?</string>
    <string name="faq_unrecognized_sms_answer">Se guardan en \'Mensajes no reconocidos\', donde puedes revisarlos manualmente o reportarlos para ayudarnos a mejorar la lectura.</string>
    <string name="faq_duplicates_question">¿Por qué algunas transacciones aparecen duplicadas?</string>
    <string name="faq_duplicates_answer">Algunos bancos envían varios SMS por la misma transacción. La app intenta detectar duplicados, pero puedes eliminar manualmente los que se cuelen.</string>
    <!-- Privacy & Data -->
    <string name="faq_privacy_section">Privacidad y datos</string>
    <string name="faq_data_secure_question">¿Mis datos financieros están seguros?</string>
    <string name="faq_data_secure_answer">¡Sí! Todos los datos se quedan en tu dispositivo. No tenemos servidores ni almacenamiento en la nube. El modelo de AI funciona localmente para una privacidad total.</string>
    <string name="faq_backup_question">¿Puedo hacer una copia de seguridad de mis datos?</string>
    <string name="faq_backup_answer">Por ahora, los datos solo se guardan localmente. Las funciones de exportación y copia de seguridad están previstas para futuras actualizaciones.</string>
    <string name="faq_data_access_question">¿A qué datos accede la app?</string>
    <string name="faq_data_access_answer">Solo a los SMS de remitentes bancarios conocidos. No leemos mensajes personales ni accedemos a datos de otras apps.</string>
    <!-- AI Features -->
    <string name="faq_ai_section">Funciones de AI</string>
    <string name="faq_ai_download_question">¿Por qué tengo que descargar el modelo de AI?</string>
    <string name="faq_ai_download_answer">El modelo de 750 MB permite chatear sobre tus gastos en el dispositivo sin enviar datos a ningún servidor, con total privacidad.</string>
    <string name="faq_ai_ask_question">¿Qué le puedo preguntar al asistente de AI?</string>
    <string name="faq_ai_ask_answer">Puedes preguntar por tus patrones de gasto, consejos de presupuesto, resúmenes de transacciones y dudas financieras generales basadas en tus datos.</string>
    <!-- Account Management -->
    <string name="faq_accounts_section">Gestión de cuentas</string>
    <string name="faq_manual_accounts_question">¿Qué son las cuentas manuales?</string>
    <string name="faq_manual_accounts_answer">Las cuentas manuales te permiten seguir efectivo, inversiones o cuentas de bancos no compatibles. Tú actualizas los saldos manualmente.</string>
    <string name="faq_multiple_accounts_question">¿Cómo sigo varias cuentas del mismo banco?</string>
    <string name="faq_multiple_accounts_answer">La app detecta automáticamente las distintas cuentas según los últimos 4 dígitos que aparecen en el SMS.</string>
