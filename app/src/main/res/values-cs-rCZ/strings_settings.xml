    <!-- Transaction Types -->
    <string name="faq_transaction_types_section">Typy transakcí</string>
    <string name="faq_wallet_credit_question">Proč jsou transakce peněženky označeny jako kredit?</string>
    <string name="faq_wallet_credit_answer">Peněženky (Amazon Pay, Paytm, atd.) jsou označeny jako Kredit, protože jsou účtovány na Váš bankovní účet nebo kreditní kartu jako první, nikoli přímé bankovní inkaso. To pomáhá sledovat skutečně použitý způsob platby.</string>
    <string name="faq_transaction_types_question">Jaký je rozdíl mezi 5 typy transakcí?</string>
    <string name="faq_transaction_types_answer">• Výdaje: Peníze z vašeho účtu (debety, nákupy, platby účtu)\n• Příjem z účtu: Peníze přicházející na Váš účet (plat, náhrady, cashback)\n• Investice: Vzájemné finanční prostředky, zásoby, SIP obchodní účty\n• Kredit: transakce kreditních karet a platby v peněžence (peníze, které zaplatíte později)\n• Převést: Peníze přesunuty mezi vašimi vlastními účty (sebepřevody)</string>
    <string name="faq_transfer_vs_expense_question">Kdy mám použít Transfer vs Expense?</string>
    <string name="faq_transfer_vs_expense_answer">Použít převod při přesouvání peněz mezi vlastními účty (např. úspory pro kontrolu). Ty neovlivňují váš čistý majetek. Pro skutečné výdaje použijte výdaje.</string>
    <!-- SMS Parsing -->
    <string name="faq_sms_parsing_section">Analýza SMS</string>
    <string name="faq_sms_not_detected_question">Proč není detekována moje bankovní SMS zpráva?</string>
    <string name="faq_sms_not_detected_answer">Zkontrolujte, zda je vaše banka podporována v našem seznamu. Pokud ne, nahlaste ji přes GitHub. Ujistěte se, že jsou udělena SMS oprávnění a formát odesílatele odpovídá standardním bankovním SMS vzorům.</string>
    <string name="faq_unrecognized_sms_question">Co se stane s neznámými SMS?</string>
    <string name="faq_unrecognized_sms_answer">Jsou uloženy v \"Nerozpoznaných zprávách\", kde je můžete ručně zkontrolovat nebo je nahlásit, abyste nám pomohli zlepšit zpracování.</string>
    <string name="faq_duplicates_question">Proč jsou některé transakce duplikovány?</string>
    <string name="faq_duplicates_answer">Některé banky odesílají více SMS pro tutéž transakci. Aplikace se snaží detekovat duplicity, ale můžete ručně smazat jakýkoliv tento doklad skrze aplikaci.</string>
    <!-- Privacy & Data -->
    <string name="faq_privacy_section">Soukromí &amp; Data</string>
    <string name="faq_data_secure_question">Jsou moje finanční údaje bezpečné?</string>
    <string name="faq_data_secure_answer">Ano! Všechna data zůstávají na vašem zařízení. Nemáme servery ani cloudové úložiště. Model AI běží lokálně pro úplné soukromí.</string>
    <string name="faq_backup_question">Mohu zálohovat svá data?</string>
    <string name="faq_backup_answer">V současné době jsou data uložena pouze lokálně. Export/zálohy funkce jsou naplánovány pro budoucí aktualizace.</string>
    <string name="faq_data_access_question">Jaká data k aplikaci přistupují?</string>
    <string name="faq_data_access_answer">Pouze SMS zprávy od známých bankovních odesílatelů. Osobní zprávy nečteme nebo přistupujeme k jiným datům aplikace.</string>
    <!-- AI Features -->
    <string name="faq_ai_section">Funkce AI</string>
    <string name="faq_ai_download_question">Proč potřebuji stáhnout AI model?</string>
    <string name="faq_ai_download_answer">Model 750MB umožňuje na zařízení chat o vašich výdajích bez zasílání dat na libovolný server, což zajistí úplné soukromí.</string>
    <string name="faq_ai_ask_question">Co mohu požádat asistenta AI?</string>
    <string name="faq_ai_ask_answer">Můžete se ptát na vzorce výdajů, rozpočtové poradenství, souhrny transakcí a obecné finanční otázky na základě Vašich údajů.</string>
    <!-- Account Management -->
    <string name="faq_accounts_section">Správa účtů</string>
    <string name="faq_manual_accounts_question">Co je to manuální účty?</string>
    <string name="faq_manual_accounts_answer">Manuální účty umožňují sledovat hotovost, investice nebo účty u nepodporovaných bank. Zůstatky aktualizujete ručně.</string>
    <string name="faq_multiple_accounts_question">Jak zaznamenám více účtů ze stejné banky?</string>
    <string name="faq_multiple_accounts_answer">Aplikace automaticky rozpoznává různé účty na základě posledních 4 číslic zobrazených v SMS.</string>
