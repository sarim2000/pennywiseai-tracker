    <!-- Transaction Types -->
    <string name="faq_transaction_types_section">أنواع المعاملات</string>
    <string name="faq_wallet_credit_question">لماذا يتم وضع علامة على معاملات المحفظة كائتمان؟</string>
    <string name="faq_wallet_credit_answer">معاملات المحفظة (دفع الأمازون، بايتم، إلخ.) تعتبر ائتمانية لأنها تُحمّل على حسابك البنكي أو بطاقة الائتمان أولا، وليس على الديون المصرفية المباشرة. وهذا يساعد على تتبع طريقة الدفع الفعلية المستخدمة.</string>
    <string name="faq_transaction_types_question">ما هو الفرق بين أنواع المعاملات الخمسة؟</string>
    <string name="faq_transfer_vs_expense_question">متى يجب أن أستخدم التحويل مقابل المصروفات؟</string>
    <string name="faq_transfer_vs_expense_answer">استخدم التحويل عند نقل المال بين حساباتك الخاصة (على سبيل المثال، المدخرات للتحقق). هذه لا تؤثر على القيمة الصافية. استخدم المصاريف للإنفاق الفعلي.</string>
    <!-- SMS Parsing -->
    <string name="faq_sms_parsing_section">تحليل الرسائل القصيرة</string>
    <string name="faq_sms_not_detected_question">لماذا لم يتم اكتشاف الرسائل القصيرة البنكية الخاصة بي؟</string>
    <string name="faq_sms_not_detected_answer">تحقق مما إذا كان البنك الخاص بك مدعوما في قائمتنا. إذا لم يكن كذلك، أبلغ عن ذلك عبر GitHub. تأكد من منح أذونات الرسائل القصيرة وأن تنسيق المرسل يتطابق مع أنماط الرسائل القصيرة للبنك.</string>
    <string name="faq_unrecognized_sms_question">ماذا يحدث للرسائل القصيرة غير المعترف بها؟</string>
    <string name="faq_unrecognized_sms_answer">تم حفظها في \"رسائل غير معترف بها\" حيث يمكنك مراجعتها يدوياً أو الإبلاغ عنها لمساعدتنا على تحسين التحليل.</string>
    <string name="faq_duplicates_question">لماذا تتكرر بعض المعاملات؟</string>
    <string name="faq_duplicates_answer">بعض البنوك ترسل رسائل قصيرة متعددة لنفس المعاملة. التطبيق يحاول الكشف عن التكرار، ولكن يمكنك حذف أي من هذه الزلاقة يدويًا.</string>
    <!-- Privacy & Data -->
    <string name="faq_privacy_section">الخصوصية &amp; البيانات</string>
    <string name="faq_data_secure_question">هل بياناتي المالية آمنة؟</string>
    <string name="faq_data_secure_answer">نعم! تبقى جميع البيانات على جهازك. ليس لدينا خوادم أو تخزين سحابي. يعمل نموذج الذكاء الاصطناعي محليا للخصوصية الكاملة.</string>
    <string name="faq_backup_question">هل يمكنني نسخ بياناتي احتياطيًا؟</string>
    <string name="faq_backup_answer">في الوقت الحالي، يتم تخزين البيانات محلياً فقط. ومن المقرر وضع ميزات التصدير/النسخ الاحتياطي من أجل التحديثات المقبلة.</string>
    <string name="faq_data_access_question">ما هي البيانات التي يصلها التطبيق؟</string>
    <string name="faq_data_access_answer">رسائل SMS فقط من المرسلين المصرفيين المعروفين. نحن لا نقرأ الرسائل الشخصية أو الوصول إلى بيانات التطبيق الأخرى.</string>
    <!-- AI Features -->
    <string name="faq_ai_section">خصائص الذكاء الاصطناعي</string>
    <string name="faq_ai_download_question">لماذا أحتاج إلى تنزيل نموذج الذكاء الاصطناعي؟</string>
    <string name="faq_ai_download_answer">يتيح نموذج 750 ميغابايت دردشة على الجهاز حول مصروفاتك دون إرسال البيانات إلى أي خادم، مما يضمن الخصوصية الكاملة.</string>
    <string name="faq_ai_ask_question">ماذا يمكنني أن أسأل مساعد الذكاء الاصطناعي؟</string>
    <string name="faq_ai_ask_answer">يمكنك أن تسأل عن أنماط الإنفاق، ونصائح الميزانية، وملخصات المعاملات، والأسئلة المالية العامة بناء على بياناتك.</string>
    <!-- Account Management -->
    <string name="faq_accounts_section">إدارة الحساب</string>
    <string name="faq_manual_accounts_question">ما هي الحسابات اليدوية؟</string>
    <string name="faq_manual_accounts_answer">الحسابات اليدوية تسمح لك بتتبع النقد، أو الاستثمارات، أو الحسابات من البنوك غير المدعومة. يمكنك تحديث الأرصدة يدويا.</string>
    <string name="faq_multiple_accounts_question">كيف يمكنني تتبع حسابات متعددة من نفس البنك؟</string>
    <string name="faq_multiple_accounts_answer">يكشف التطبيق تلقائياً حسابات مختلفة استناداً إلى آخر 4 أرقام تظهر في الرسائل القصيرة.</string>
