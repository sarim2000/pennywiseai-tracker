    <!-- Transaction Types -->
    <string name="faq_transaction_types_section">أنواع المعاملات</string>
    <string name="faq_wallet_credit_question">لماذا تُصنَّف معاملات المحفظة كائتمان؟</string>
    <string name="faq_wallet_credit_answer">تُصنَّف معاملات المحفظة (Amazon Pay وPaytm وغيرها) كائتمان لأنها تُخصم أولًا من حسابك البنكي أو بطاقتك الائتمانية، وليست خصمًا مباشرًا من البنك. يساعد ذلك على تتبّع طريقة الدفع الفعلية.</string>
    <string name="faq_transaction_types_question">ما هو الفرق بين أنواع المعاملات الخمسة؟</string>
    <string name="faq_transaction_types_answer">• مصروف: أموال تخرج من حسابك (خصومات، مشتريات، دفع فواتير)\n• دخل: أموال تدخل إلى حسابك (راتب، مبالغ مستردة، استرداد نقدي)\n• استثمار: صناديق استثمار مشتركة، أسهم، استثمارات دورية (SIP)، حسابات تداول\n• ائتمان: معاملات بطاقات الائتمان ومدفوعات المحافظ (أموال ستدفعها لاحقًا)\n• تحويل: أموال تنتقل بين حساباتك الخاصة (تحويلات ذاتية)</string>
    <string name="faq_transfer_vs_expense_question">متى أستخدم التحويل ومتى أستخدم المصروف؟</string>
    <string name="faq_transfer_vs_expense_answer">استخدم التحويل عند نقل المال بين حساباتك (مثلًا من حساب التوفير إلى الحساب الجاري). لا يؤثر ذلك على صافي ثروتك. واستخدم المصروف للإنفاق الفعلي.</string>
    <!-- SMS Parsing -->
    <string name="faq_sms_parsing_section">تحليل الرسائل القصيرة</string>
    <string name="faq_sms_not_detected_question">لماذا لا يكتشف التطبيق رسائل البنك القصيرة؟</string>
    <string name="faq_sms_not_detected_answer">تحقق مما إذا كان بنكك مدعومًا في قائمتنا. إن لم يكن كذلك، أبلغ عنه عبر GitHub. وتأكد من منح إذن الرسائل القصيرة ومن أن صيغة المرسل تطابق الأنماط المعتادة لرسائل البنوك.</string>
    <string name="faq_unrecognized_sms_question">ماذا يحدث للرسائل التي لم يُتعرّف عليها؟</string>
    <string name="faq_unrecognized_sms_answer">تُحفظ في \"رسائل لم يُتعرّف عليها\" حيث يمكنك مراجعتها يدويًا أو الإبلاغ عنها لمساعدتنا على تحسين التحليل.</string>
    <string name="faq_duplicates_question">لماذا تتكرر بعض المعاملات؟</string>
    <string name="faq_duplicates_answer">ترسل بعض البنوك أكثر من رسالة للمعاملة نفسها. يحاول التطبيق اكتشاف التكرار، لكن يمكنك حذف أي معاملة مكررة تفلت منه يدويًا.</string>
    <!-- Privacy & Data -->
    <string name="faq_privacy_section">الخصوصية والبيانات</string>
    <string name="faq_data_secure_question">هل بياناتي المالية آمنة؟</string>
    <string name="faq_data_secure_answer">نعم! تبقى جميع البيانات على جهازك. ليس لدينا خوادم أو تخزين سحابي. يعمل نموذج الذكاء الاصطناعي محليا للخصوصية الكاملة.</string>
    <string name="faq_backup_question">هل يمكنني نسخ بياناتي احتياطيًا؟</string>
    <string name="faq_backup_answer">حاليًا تُخزَّن البيانات محليًا فقط. ميزات التصدير والنسخ الاحتياطي مخطط لها في تحديثات قادمة.</string>
    <string name="faq_data_access_question">ما البيانات التي يصل إليها التطبيق؟</string>
    <string name="faq_data_access_answer">الرسائل القصيرة من مرسلي البنوك المعروفين فقط. لا نقرأ الرسائل الشخصية ولا نصل إلى بيانات التطبيقات الأخرى.</string>
    <!-- AI Features -->
    <string name="faq_ai_section">ميزات الذكاء الاصطناعي</string>
    <string name="faq_ai_download_question">لماذا أحتاج إلى تنزيل نموذج الذكاء الاصطناعي؟</string>
    <string name="faq_ai_download_answer">يتيح نموذج 750 ميغابايت دردشة على الجهاز حول مصروفاتك دون إرسال البيانات إلى أي خادم، مما يضمن الخصوصية الكاملة.</string>
    <string name="faq_ai_ask_question">ماذا يمكنني أن أسأل مساعد الذكاء الاصطناعي؟</string>
    <string name="faq_ai_ask_answer">يمكنك أن تسأل عن أنماط الإنفاق، ونصائح الميزانية، وملخصات المعاملات، والأسئلة المالية العامة بناء على بياناتك.</string>
    <!-- Account Management -->
    <string name="faq_accounts_section">إدارة الحسابات</string>
    <string name="faq_manual_accounts_question">ما هي الحسابات اليدوية؟</string>
    <string name="faq_manual_accounts_answer">تتيح لك الحسابات اليدوية تتبّع النقد أو الاستثمارات أو حسابات البنوك غير المدعومة، وتحدّث أرصدتها بنفسك.</string>
    <string name="faq_multiple_accounts_question">كيف يمكنني تتبع حسابات متعددة من نفس البنك؟</string>
    <string name="faq_multiple_accounts_answer">يكتشف التطبيق الحسابات المختلفة تلقائيًا من آخر 4 أرقام تظهر في الرسائل القصيرة.</string>
