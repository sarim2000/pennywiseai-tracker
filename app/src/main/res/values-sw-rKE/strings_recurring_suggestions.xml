<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Subscriptions screen: "Suggested" section listing payments that repeat in the user's history but aren't tracked yet -->
    <string name="subscriptions_suggested_section">Mapendekezo</string>
    <string name="subscriptions_suggested_hint">Malipo yanayojirudia katika historia yako. Hayahesabiwi hadi uyafuatilie.</string>
    <!-- %1$d: total number of suggestions -->
    <string name="subscriptions_suggested_show_all">Onyesha yote (%1$d)</string>
    <string name="subscriptions_suggested_show_less">Onyesha machache</string>
    <!-- Suggestion row: "%1$s · %2$s" = billing cycle (e.g. "Monthly") · payment count (subscription_suggestion_payments) -->
    <plurals name="subscription_suggestion_payments">
        <item quantity="one">Malipo %1$d</item>
        <item quantity="other">Malipo %1$d</item>
    </plurals>
    <!-- Amount range of a bill whose amount changes. %1$s lowest amount, %2$s highest amount, both with currency -->
    <string name="subscription_suggestion_varies">Kiasi hubadilika</string>
    <string name="subscription_suggestion_review">Kagua</string>
    <string name="subscription_suggestion_not_recurring">Hayajirudii</string>
    <!-- Review sheet. %1$s billing cycle (e.g. "Monthly"), %2$s category -->
    <plurals name="subscription_suggestion_sheet_found">
        <item quantity="one">Malipo %1$d yamepatikana</item>
        <item quantity="other">Malipo %1$d yamepatikana</item>
    </plurals>
    <!-- %1$s: currency code, e.g. "USD" -->
    <string name="subscription_suggestion_sheet_amount">Kiasi cha kufuatilia (%1$s)</string>
    <string name="subscription_suggestion_sheet_variable_hint">Bili hii hubadilika kila mara. Unaweza kubadilisha kiasi baadaye.</string>
    <!-- %1$s: date, e.g. "15 Nov 2026" -->
    <string name="subscription_suggestion_sheet_next">Malipo yajayo yanatarajiwa %1$s</string>
    <string name="subscription_suggestion_sheet_track">Fuatilia bili</string>
    <string name="subscription_suggestion_sheet_helper">Utapata kikumbusho siku moja kabla ya kila malipo.</string>
    <!-- Snackbars. %1$s: merchant name -->
    <string name="subscriptions_suggestion_tracked">Sasa inafuatilia %1$s</string>
    <string name="subscriptions_suggestion_already_tracked">%1$s tayari inafuatiliwa</string>
    <string name="subscriptions_suggestion_dismissed">%1$s haitapendekezwa tena</string>
    <!-- Home card linking to the suggestions -->
    <plurals name="home_recurring_card_title">
        <item quantity="one">Bili %1$d inayoweza kujirudia</item>
        <item quantity="other">Bili %1$d zinazoweza kujirudia</item>
    </plurals>
    <!-- %1$s: one or two merchant names, comma-separated -->
    <string name="home_recurring_card_body">%1$s. Kagua ili upate kikumbusho kabla ya kila malipo.</string>
    <!-- %1$s: two merchant names, comma-separated; %2$d: how many more, shown as "+2" -->
    <string name="home_recurring_card_body_more">%1$s +%2$d. Kagua ili upate kikumbusho kabla ya kila malipo.</string>
    <string name="home_recurring_card_action">Kagua</string>
    <string name="home_recurring_card_dismiss">Ficha</string>
</resources>
