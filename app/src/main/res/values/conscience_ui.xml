    <string name="conscience_kind_spike_desc">A week well above your usual in a category</string>
    <string name="conscience_kind_hello">Quick hellos</string>
    <string name="conscience_kind_hello_desc">A wave now and then, so you know it\'s still awake</string>

    <!-- How often -->
    <string name="conscience_frequency_title">How often</string>
    <string name="conscience_frequency_normal">Normal</string>
