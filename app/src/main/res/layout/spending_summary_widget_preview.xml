<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview for the spending summary widget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="12dp"
    android:theme="@style/Theme.Pennywisecompose">

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/widget_summary_today"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/widget_summary_month"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="14sp" />

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/widget_add_content_description"
        android:padding="10dp"
        android:src="@drawable/ic_widget_add"
        android:tint="?android:attr/textColorPrimary" />
</LinearLayout>
