    <string name="home_recurring_card_body">%1$s. راجعها لتتلقى تذكيرًا قبل كل دفعة.</string>
    <!-- %1$s: two merchant names, comma-separated; %2$d: how many more, shown as "+2" -->
    <string name="home_recurring_card_body_more">%1$s +%2$d. راجعها لتتلقى تذكيرًا قبل كل دفعة.</string>
    <string name="home_recurring_card_action">مراجعة</string>
    <string name="home_recurring_card_dismiss">إخفاء</string>
