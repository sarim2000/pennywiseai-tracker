    <string name="faq_ai_section">Funkce AI</string>
    <string name="faq_ai_download_question">Proč potřebuji stáhnout AI model?</string>
    <string name="faq_ai_download_answer">Model 750MB umožňuje na zařízení chat o vašich výdajích bez zasílání dat na libovolný server, což zajistí úplné soukromí.</string>
    <string name="faq_ai_ask_question">Co mohu požádat asistenta AI?</string>
